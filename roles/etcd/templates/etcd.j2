name: "{{ inventory_hostname }}"
initial-advertise-peer-urls: https://"{{ ansible_host }}":2380
listen-peer-urls: https://"{{ ansible_host }}":2380
listen-client-urls: https://"{{ ansible_host }}":2379,https://127.0.0.1:2379
advertise-client-urls: https://"{{ ansible_host }}":2379
initial-cluster-token: "{{ initial_cluster_token }}"
initial-cluster: "{{ initial_cluster }}"
initial-cluster-state: 'new'
data-dir: /data
wal-dir: /wal/wal-data
snapshot-count: 10000
heartbeat-interval: 100
election-timeout: 1000
quota-backend-bytes: 0
max-snapshots: 5
max-wals: 5

# Reject reconfiguration requests that would cause quorum loss.
strict-reconfig-check: false

# Accept etcd V2 client requests
enable-v2: true

# Enable runtime profiling data via HTTP server
enable-pprof: true
metrics: basic

# Valid values include 'on', 'readonly', 'off'
proxy: 'off'

client-transport-security:
  cert-file: /etc/pki/"{{ inventory_hostname }}".crt
  key-file: /etc/pki/"{{ inventory_hostname }}"-private.key
  client-cert-auth: true
  trusted-ca-file: /etc/pki/ca.crt
  auto-tls: true

peer-transport-security:
  cert-file: /etc/pki/"{{ inventory_hostname }}".crt
  key-file: /etc/pki/"{{ inventory_hostname }}"-private.key
  client-cert-auth: true
  trusted-ca-file: /etc/pki/ca.crt
  auto-tls: true

# Enable debug-level logging for etcd.
debug: true

logger: zap

# Specify 'stdout' or 'stderr' to skip journald logging even when running under systemd.
log-outputs: [stderr]

# Force to create a new one member cluster.
force-new-cluster: false

auto-compaction-mode: periodic
auto-compaction-retention: "1"