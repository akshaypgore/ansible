global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy #changes current working directory for a process and its children
    user haproxy
    group haproxy
    daemon

    # Production performance tuning
    maxconn 50000
    ssl-default-bind-ciphers PROFILE=SYSTEM
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    log     global
    mode    tcp                # Crucial: Must be Layer 4 TCP for K8s API server
    option  tcplog
    option  dontlognull
    retries 3
    timeout queue           1m
    timeout connect         10s
    timeout client          30m # Keep kubernetes watch streams alive
    timeout server          30m # Keep kubernetes watch streams alive
    timeout check           10s

#---------------------------------------------------------------------
# K8s Control Plane (API Server) Load Balancing
#---------------------------------------------------------------------
frontend k8s_api_frontend
    bind 192.168.1.10:6443     # Bind strictly to your VIP
    mode tcp
    default_backend k8s_api_backend

backend k8s_api_backend
    mode tcp
    option tcp-check
    balance roundrobin         # Even distribution
    # Kubernetes API native health endpoint (/readyz) via HTTP check over SSL
    option httpchk GET /readyz
    http-check expect status 200

    {% for host in groups['k8s-master-server']%}
    server {{ host }} {{ hostvars[host]['ansible_host']}}:6443 check check-ssl verify none inter 2000 rise 2 fall 3
    {% endfor %}

